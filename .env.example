# Development only. Generate a unique value before leaving localhost.
STEERLOOP_TOKEN=replace-with-at-least-32-random-bytes
# Prefer a root-readable file for services. Do not set both token variables.
# STEERLOOP_TOKEN_FILE=/run/secrets/steerloop-token

# Relay and agent defaults.
STEERLOOP_RELAY_HOST=127.0.0.1
STEERLOOP_RELAY_PORT=8787
STEERLOOP_RELAY_URL=ws://127.0.0.1:8787/ws
STEERLOOP_HOST_ID=my-workstation
STEERLOOP_HOST_NAME=My Workstation

# Use "demo" for the guided sample or "codex" for local Codex App Server.
STEERLOOP_ADAPTER=demo
# STEERLOOP_CODEX_COMMAND=/absolute/path/to/codex

# Relay event persistence. Set the path to "off" only for disposable testing.
STEERLOOP_JOURNAL_PATH=steerloop-data/relay-events.jsonl
STEERLOOP_JOURNAL_SYNC=true

# Set to 0.0.0.0 only for an explicitly trusted development network.
STEERLOOP_WEB_HOST=127.0.0.1
