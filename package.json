{
  "name": "steerloop",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first control plane for long-running AI agent tasks.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18",
    "npm": ">=9"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "compat:codex": "tsx scripts/compat/codex-app-server.ts",
    "dev": "concurrently -k -n relay,agent,web -c blue,magenta,green \"npm:dev:relay\" \"npm:dev:agent\" \"npm:dev:web\"",
    "dev:agent": "npm run dev -w @steerloop/agent",
    "dev:relay": "npm run dev -w @steerloop/relay",
    "dev:web": "npm run dev -w @steerloop/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
